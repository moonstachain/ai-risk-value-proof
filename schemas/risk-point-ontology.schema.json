{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moonstachain/ai-risk-value-proof/schemas/risk-point-ontology.schema.json",
  "title": "Risk Point Ontology",
  "description": "A minimal schema for the risk reduction ledger. It keeps examples separate from verified customer data.",
  "type": "object",
  "required": ["risk_point_id", "name", "scenario", "ontology", "lifecycle", "signals", "value_metrics", "fact_boundary"],
  "properties": {
    "risk_point_id": {
      "type": "string",
      "description": "Unique key for one risk point. Example format: SCENE-AREA-POINT-001"
    },
    "name": {
      "type": "string"
    },
    "scenario": {
      "type": "string",
      "description": "Pilot scenario or domain"
    },
    "owner": {
      "type": "object",
      "properties": {
        "department": {"type": "string"},
        "responsible_role": {"type": "string"},
        "contact_status": {"type": "string", "enum": ["unknown", "identified", "confirmed"]}
      }
    },
    "ontology": {
      "type": "object",
      "required": ["object", "relation", "action", "spacetime"],
      "properties": {
        "object": {"type": "string"},
        "relation": {"type": "array", "items": {"type": "string"}},
        "action": {"type": "array", "items": {"type": "string"}},
        "spacetime": {"type": "array", "items": {"type": "string"}}
      }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "L1_archive": {"$ref": "#/$defs/status"},
        "L2_monitor": {"$ref": "#/$defs/status"},
        "L3_judge": {"$ref": "#/$defs/status"},
        "L4_prevent": {"$ref": "#/$defs/status"},
        "L5_backwrite": {"$ref": "#/$defs/status"}
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal_id", "signal_type", "status"],
        "properties": {
          "signal_id": {"type": "string"},
          "signal_type": {"type": "string"},
          "source": {"type": "string"},
          "status": {"type": "string", "enum": ["online", "offline", "missing", "pending", "unknown"]},
          "latest_value": {"type": ["string", "number", "null"]},
          "threshold": {"type": ["string", "number", "null"]},
          "updated_at": {"type": ["string", "null"]},
          "evidence_level": {"type": "string", "enum": ["demo", "provided", "verified", "public"]}
        }
      }
    },
    "value_metrics": {
      "type": "object",
      "properties": {
        "coverage": {"type": ["number", "null"]},
        "response": {"type": ["number", "null"]},
        "reuse": {"type": ["number", "null"]},
        "legacy": {"type": ["number", "null"]}
      }
    },
    "fact_boundary": {
      "type": "object",
      "required": ["data_status", "public_usage"],
      "properties": {
        "data_status": {"type": "string", "enum": ["demo", "draft", "customer_provided", "verified"]},
        "public_usage": {"type": "string", "enum": ["internal_only", "desensitized", "approved_public"]},
        "notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "status": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["green", "yellow", "orange", "red", "not_started"]},
        "notes": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
